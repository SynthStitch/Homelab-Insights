# Copy to .env before `docker compose up`. Everything else has sane defaults.
JWT_SECRET=change-me-to-something-long

# Proxmox fallback (you can also add nodes in the Admin UI after signing in)
PROXMOX_API_BASE=https://192.168.1.10:8006/api2/json
PROXMOX_API_TOKEN_ID=root@pam!insights
PROXMOX_API_TOKEN_SECRET=
PROXMOX_DEFAULT_NODE=pve
PROXMOX_DEFAULT_VMID=100
PROXMOX_REJECT_UNAUTHORIZED=false

# Optional
OPENAI_API_KEY=
